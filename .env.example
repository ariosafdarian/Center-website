# --- Bale bot (primary destination) ---
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Needed on Iranian hosts, e.g. http://user:pass@host:port
TELEGRAM_PROXY=

# --- Storage & limits ---
SAVE_TO_FILE=true
DATA_DIR=./data
RATE_LIMIT_PER_HOUR=6

# Comma-separated; when set, POSTs from any other Origin are rejected (403)
ALLOWED_ORIGINS=
SITE_URL=

# Stage 1 design lab (/lab). Keep false in production.
LAB_ENABLED=false

# Production builds fail while any content file has sample: true, unless this is 1
ALLOW_SAMPLE=

# Test-only overrides for the bot API base URLs (leave empty in production)
BALE_API_BASE=
TELEGRAM_API_BASE=
